{
  "name": "Assura",
  "image": "mcr.microsoft.com/devcontainers/rust:1-1-bookworm",
  "features": {},
  "customizations": {
    "vscode": {
      "extensions": ["rust-lang.rust-analyzer"]
    }
  },
  "onCreateCommand": "sudo apt-get update && sudo apt-get install -y libz3-dev && rustup update stable && rustup default stable",
  "updateContentCommand": "cargo build --locked -p assura",
  "postAttachCommand": "bash .devcontainer/welcome.sh",
  "forwardPorts": [],
  "remoteUser": "vscode",
  "hostRequirements": {
    "cpus": 4
  }
}
